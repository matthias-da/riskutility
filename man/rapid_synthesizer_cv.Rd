    synthesizer = function(data, seed = NULL) {
      synthpop::syn(data, m = 1, seed = seed, print.flag = FALSE)$syn
    },
    key_vars = c("age", "sex"), target_var = "income",
    model_type = "rf", k = 5, seed = 1
  )
  print(cv)
}
